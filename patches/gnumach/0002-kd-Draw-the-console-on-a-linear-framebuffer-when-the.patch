+#ifndef _I386AT_KD_FB_H_
+#define _I386AT_KD_FB_H_	1
+
+#include <mach/boolean.h>
+
+/*
+ * Switch the kd display layer to the linear framebuffer described by the
+ * multiboot information, if the boot loader provided one.  Returns FALSE
+ * when there is no usable framebuffer, in which case the caller keeps
+ * using the EGA text buffer.
+ */
+boolean_t kd_fb_init(void);
+
+/* Print the framebuffer geometry once the console works.  */
+void kd_fb_report(void);
