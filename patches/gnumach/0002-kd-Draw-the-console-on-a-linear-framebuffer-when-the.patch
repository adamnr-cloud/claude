diff --git a/i386/i386at/kd_fb.c b/i386/i386at/kd_fb.c
new file mode 100644
index 000000000..da8d33b5c
--- /dev/null
+++ b/i386/i386at/kd_fb.c
@@ -0,0 +1,279 @@
+/*
