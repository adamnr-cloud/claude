+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Kernel console on a linear framebuffer.
+ *
+ * Firmware such as coreboot with a framebuffer payload, or UEFI, leaves the
+ * display in a graphics mode with no EGA text buffer behind 0xb8000.  When
+ * the boot loader describes such a framebuffer in the multiboot information,
+ * the kd display layer is pointed at an in-memory EGA-style text page
+ * instead, and every change to that page is painted onto the framebuffer
+ * with an 8x16 font.  The rest of kd.c keeps working on 80x25 character
+ * cells exactly as it does for a real EGA adapter.
+ */
+
+#include <string.h>
+#include <kern/printf.h>
+#include <sys/types.h>
+#include <mach/machine/multiboot.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_map.h>
+#include <vm/pmap.h>
+#include <i386at/kd.h>
+#include <i386at/kdsoft.h>
+#include <i386at/kd_fb.h>
+
+#include "kd_fb_font.h"
+
+#define KDFB_CELLS	(ONE_PAGE / ONE_SPACE)
+#define KDFB_CHAR_W	8
+#define KDFB_CHAR_H	16
+#define KDFB_CURSOR_H	2	/* scan lines of the underline cursor */
+#define KDFB_NOT_SHOWN	0xffffffff
+
+extern struct multiboot_raw_info boot_info;
+
+/* The EGA-style text page kd.c works on: character, attribute pairs.  */
+static u_char kdfb_text[ONE_PAGE];
+
+/* What each cell currently shows on the framebuffer, to only repaint the
+   cells that changed.  */
+static uint32_t kdfb_shown[KDFB_CELLS];
+
+static u_char *kdfb_base;		/* kernel mapping of the framebuffer */
+static unsigned int kdfb_pitch;		/* bytes per scan line */
+static unsigned int kdfb_bytespp;	/* bytes per pixel */
+static uint32_t kdfb_palette[16];	/* EGA colours as pixel values */
+static csrpos_t kdfb_cursor = -1;	/* cell showing the cursor, if any */
+
+/* The standard EGA/VGA text mode palette.  */
+static const u_char kdfb_ega_rgb[16][3] = {
+	{ 0x00, 0x00, 0x00 }, { 0x00, 0x00, 0xaa },
+	{ 0x00, 0xaa, 0x00 }, { 0x00, 0xaa, 0xaa },
+	{ 0xaa, 0x00, 0x00 }, { 0xaa, 0x00, 0xaa },
+	{ 0xaa, 0x55, 0x00 }, { 0xaa, 0xaa, 0xaa },
+	{ 0x55, 0x55, 0x55 }, { 0x55, 0x55, 0xff },
+	{ 0x55, 0xff, 0x55 }, { 0x55, 0xff, 0xff },
+	{ 0xff, 0x55, 0x55 }, { 0xff, 0x55, 0xff },
+	{ 0xff, 0xff, 0x55 }, { 0xff, 0xff, 0xff },
+};
+
+static uint32_t
+kdfb_channel(unsigned int value, unsigned int size, unsigned int position)
+{
+	if (size == 0)
+		return 0;
+	if (size < 8)
+		value >>= 8 - size;
+	else
+		value <<= size - 8;
+	return (uint32_t) value << position;
+}
+
+static void
+kdfb_put_pixel(u_char *p, uint32_t pixel)
+{
+	switch (kdfb_bytespp) {
+	case 4:
+		*(volatile uint32_t *) p = pixel;
+		break;
+	case 3:
+		((volatile u_char *) p)[0] = pixel;
+		((volatile u_char *) p)[1] = pixel >> 8;
+		((volatile u_char *) p)[2] = pixel >> 16;
+		break;
+	case 2:
+		*(volatile uint16_t *) p = pixel;
+		break;
+	}
+}
+
+/* Paint cell CELL from the text page, with the cursor if it is there.  */
+static void
+kdfb_paint(int cell)
+{
+	u_char ch = kdfb_text[cell * ONE_SPACE];
+	u_char attr = kdfb_text[cell * ONE_SPACE + 1];
+	boolean_t cursor = (kdfb_cursor >= 0 && cell == kdfb_cursor / ONE_SPACE);
+	uint32_t key = ch | (attr << 8) | (cursor << 16);
+	uint32_t fg = kdfb_palette[attr & 0x0f];
+	uint32_t bg = kdfb_palette[(attr >> 4) & 0x07];
+	u_char *line;
+	int x, y;
+
+	if (kdfb_shown[cell] == key)
+		return;
+	kdfb_shown[cell] = key;
+
+	line = kdfb_base
+	       + (cell / kd_cols) * KDFB_CHAR_H * kdfb_pitch
+	       + (cell % kd_cols) * KDFB_CHAR_W * kdfb_bytespp;
+
+	for (y = 0; y < KDFB_CHAR_H; y++, line += kdfb_pitch) {
+		u_char bits = kdfb_font[ch][y];
+		u_char *p = line;
+
+		if (cursor && y >= KDFB_CHAR_H - KDFB_CURSOR_H)
+			bits = 0xff;
+		for (x = 0; x < KDFB_CHAR_W; x++, p += kdfb_bytespp)
+			kdfb_put_pixel(p, (bits & (0x80 >> x)) ? fg : bg);
+	}
+}
+
+static void
+kdfb_paint_all(void)
+{
+	int cell;
+
+	for (cell = 0; cell < KDFB_CELLS; cell++)
+		kdfb_paint(cell);
+}
+
+static void
+kdfb_put(csrpos_t pos, char ch, char chattr)
+{
+	if (pos < 0 || pos >= ONE_PAGE)
+		return;
+	kdfb_text[pos] = ch;
+	kdfb_text[pos + 1] = chattr;
+	kdfb_paint(pos / ONE_SPACE);
+}
+
+static void
+kdfb_mvup(csrpos_t from, csrpos_t to, int count)
+{
+	kd_slmscu(kdfb_text + from, kdfb_text + to, count);
+	kdfb_paint_all();
+}
+
+static void
+kdfb_mvdown(csrpos_t from, csrpos_t to, int count)
+{
+	kd_slmscd(kdfb_text + from, kdfb_text + to, count);
+	kdfb_paint_all();
+}
+
+static void
+kdfb_clear(csrpos_t to, int count, char chattr)
+{
+	kd_slmwd(kdfb_text + to, count, ((unsigned short) chattr << 8) + K_SPACE);
+	kdfb_paint_all();
+}
+
+static void
+kdfb_setcursor(csrpos_t newpos)
+{
+	csrpos_t old = kdfb_cursor;
+
+	kdfb_cursor = (newpos >= 0 && newpos < ONE_PAGE) ? newpos : -1;
+	if (old >= 0)
+		kdfb_paint(old / ONE_SPACE);
+	if (kdfb_cursor >= 0)
+		kdfb_paint(kdfb_cursor / ONE_SPACE);
+
+	kd_curpos = newpos;
+}
+
+boolean_t
+kd_fb_init(void)
+{
+	const struct multiboot_framebuffer_info *fb = &boot_info.fb_info;
+	phys_addr_t start, end;
+	vm_offset_t addr;
+	vm_size_t size;
+	int i;
+
+	if (!(boot_info.flags & MULTIBOOT_FRAMEBUFFER))
+		return FALSE;
+	if (fb->framebuffer_type != MULTIBOOT_FRAMEBUFFER_TYPE_RGB)
+		return FALSE;
+	switch (fb->framebuffer_bpp) {
+	case 15: case 16: case 24: case 32:
+		break;
+	default:
+		return FALSE;
+	}
+	kdfb_bytespp = (fb->framebuffer_bpp + 7) / 8;
+	if (fb->framebuffer_width < kd_cols * KDFB_CHAR_W
+	    || fb->framebuffer_height < kd_lines * KDFB_CHAR_H
+	    || fb->framebuffer_pitch < fb->framebuffer_width * kdfb_bytespp)
+		return FALSE;
+
+	/* The framebuffer is outside the direct physical mapping, so it needs
+	   its own kernel mapping, which needs the VM system.  */
+	if (kernel_map == VM_MAP_NULL)
+		return FALSE;
+
+	size = (vm_size_t) fb->framebuffer_pitch * fb->framebuffer_height;
+	start = fb->framebuffer_addr;
+	if ((uint64_t) start != fb->framebuffer_addr)
+		return FALSE;	/* Not addressable by this kernel.  */
+	end = round_page(start + size);
+	start = trunc_page(start);
+	if (kmem_valloc(kernel_map, &addr, end - start) != KERN_SUCCESS)
+		return FALSE;
+	(void) pmap_map_bd(addr, start, end, VM_PROT_READ | VM_PROT_WRITE);
+
+	kdfb_base = (u_char *) addr + (fb->framebuffer_addr - start);
+	kdfb_pitch = fb->framebuffer_pitch;
+
+	for (i = 0; i < 16; i++)
+		kdfb_palette[i] =
+		  kdfb_channel(kdfb_ega_rgb[i][0],
+			       fb->framebuffer_red_mask_size,
+			       fb->framebuffer_red_field_position)
+		  | kdfb_channel(kdfb_ega_rgb[i][1],
+				 fb->framebuffer_green_mask_size,
+				 fb->framebuffer_green_field_position)
+		  | kdfb_channel(kdfb_ega_rgb[i][2],
+				 fb->framebuffer_blue_mask_size,
+				 fb->framebuffer_blue_field_position);
+
+	/* Start from a blank screen: whatever the boot loader left there would
+	   otherwise stay around the 80x25 area.  */
+	memset(kdfb_base, 0, size);
+	for (i = 0; i < KDFB_CELLS; i++) {
+		kdfb_text[i * ONE_SPACE] = K_SPACE;
+		kdfb_text[i * ONE_SPACE + 1] = KA_NORMAL;
+		kdfb_shown[i] = KDFB_NOT_SHOWN;
+	}
+
+	vid_start = kdfb_text;
+	kd_dput = kdfb_put;
+	kd_dmvup = kdfb_mvup;
+	kd_dmvdown = kdfb_mvdown;
+	kd_dclear = kdfb_clear;
+	kd_dsetcursor = kdfb_setcursor;
+
+	kdfb_paint_all();
+	return TRUE;
+}
+
+void
+kd_fb_report(void)
+{
+	const struct multiboot_framebuffer_info *fb = &boot_info.fb_info;
+
+	printf("kd: framebuffer at 0x%llx, %ux%ux%u, pitch %u, rgb %u:%u %u:%u %u:%u\n",
+	       (unsigned long long) fb->framebuffer_addr,
+	       fb->framebuffer_width, fb->framebuffer_height,
+	       fb->framebuffer_bpp, fb->framebuffer_pitch,
+	       fb->framebuffer_red_field_position, fb->framebuffer_red_mask_size,
+	       fb->framebuffer_green_field_position, fb->framebuffer_green_mask_size,
+	       fb->framebuffer_blue_field_position, fb->framebuffer_blue_mask_size);
+}
