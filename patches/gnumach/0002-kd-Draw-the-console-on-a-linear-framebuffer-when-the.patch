 i386/i386at/kd.c         |  10 ++
 i386/i386at/kd_fb.c      | 279 +++++++++++++++++++++++++++++++++++++++
 i386/i386at/kd_fb.h      |  34 +++++
 i386/i386at/kd_fb_font.h | 262 ++++++++++++++++++++++++++++++++++++
 x86_64/Makefrag.am       |   3 +
 6 files changed, 591 insertions(+)
 create mode 100644 i386/i386at/kd_fb.c
 create mode 100644 i386/i386at/kd_fb.h
 create mode 100644 i386/i386at/kd_fb_font.h

